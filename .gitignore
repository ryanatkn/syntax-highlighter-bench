# Deps
node_modules/

# Output
.svelte-kit/
build/
dist/
dist_*/
target/
.gro/
.fuz/
.zzz/

# Benchmark runs that are not publishable: smoke and filtered ones
/results/scratch/
# The journal of a timed run that hasn't finished, or that was set aside
/results/*.journal.jsonl
/results/*.journal.jsonl.overlapped

# Env
.env*
!.env.example
!.env.*.example
!.env.test
!.env.*.test

# Secrets
*.pem
id_rsa

# Local (per-machine, never shared)
*.local
*.local.*

# Ignore
*.ignore
*.ignore.*
ignore

# Temporary files
tmp/
*.tmp
.tmp*
*.bak

# Log files
*.log

# Workflow
/worktree

# Os
.DS_Store
Thumbs.db
