{
  "name": "@ryanatkn/syntax-highlighter-bench",
  "version": "0.0.1",
  "description": "neutral benchmark suite and results site for JS syntax highlighters",
  "license": "MIT",
  "homepage": "https://syntax-highlighter-bench.ryanatkn.com/",
  "private": true,
  "repository": "https://github.com/ryanatkn/syntax-highlighter-bench",
  "scripts": {
    "start": "gro dev",
    "dev": "gro dev",
    "build": "gro build",
    "check": "gro check",
    "test": "gro test",
    "preview": "vite preview",
    "deploy": "gro deploy",
    "bench": "node bench/run.ts",
    "bench:smoke": "node bench/run.ts --smoke",
    "bench:calibrate": "node bench/run.ts --calibrate",
    "bench:deterministic": "node bench/deterministic.ts",
    "results:publish": "node bench/publish.ts",
    "corpus:manifest": "node bench/corpus_manifest.ts",
    "corpus:check": "node bench/corpus_manifest.ts --check",
    "corpus:fetch": "node bench/corpus_fetch.ts",
    "corpus:harvest": "node bench/corpus_harvest_svelte.ts",
    "corpus:stress": "node bench/corpus_stress.ts"
  },
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*",
    "#routes/*": "./src/routes/*"
  },
  "engines": {
    "node": ">=24.14"
  },
  "devDependencies": {
    "@fuzdev/blake3-wasm": "^0.2.0",
    "@fuzdev/fuz_code": "^0.52.1",
    "@fuzdev/fuz_css": "^0.66.1",
    "@fuzdev/fuz_ui": "^0.213.0",
    "@fuzdev/fuz_util": "^0.72.0",
    "@fuzdev/gro": "^0.216.0",
    "@fuzdev/mdz": "^0.4.0",
    "@ryanatkn/eslint-config": "^0.13.0",
    "@sveltejs/acorn-typescript": "^1.0.10",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@twinkleplop/bash": "^0.1.5",
    "@twinkleplop/core": "^0.2.2",
    "@twinkleplop/css": "^0.1.5",
    "@twinkleplop/html": "^0.1.5",
    "@twinkleplop/javascript": "^0.1.5",
    "@twinkleplop/json": "^0.1.5",
    "@twinkleplop/markdown": "^0.1.5",
    "@twinkleplop/rust": "^0.1.5",
    "@twinkleplop/svelte": "^0.1.5",
    "@twinkleplop/theme-github": "^0.2.2",
    "@twinkleplop/typescript": "^0.1.5",
    "@types/estree": "^1.0.8",
    "@types/node": "^24.12.4",
    "@types/prismjs": "^1.26.6",
    "@webref/css": "^8.2.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.1",
    "eslint-plugin-svelte": "^3.13.1",
    "esm-env": "^1.2.2",
    "magic-string": "^0.30.21",
    "prism-svelte": "^0.5.0",
    "prismjs": "^1.30.0",
    "shiki": "^4.4.3",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "svelte-docinfo": "^0.9.0",
    "svelte2tsx": "^0.7.56",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.0",
    "zimmerframe": "^1.1.4",
    "zod": "^4.3.6"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
